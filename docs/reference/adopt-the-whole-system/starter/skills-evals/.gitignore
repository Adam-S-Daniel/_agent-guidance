# Raw eval artifacts stay local; only summarized reports are committed.
results/**/transcripts/
results/**/*.jsonl
__pycache__/
*.pyc
# The adoption kit's copy-starter.sh skips these when it copies the tree;
# ignoring them here keeps them out of the adopter's first commits too.
.pytest_cache/
node_modules/
.DS_Store

# Published on the `persistent/eval-results` branch, untracked on main - same asymmetry
# as results/. A local run leaves these behind; they must never ride into a
# main-branch PR. eval.yml (roster/) and scripts/publish_usage_census.sh
# (usage/, run from the owner's machine) publish them with an explicit
# `git add -f` on the persistent/eval-results branch, which is what makes the asymmetry
# work rather than silently dropping them.
roster/
usage/
!/evals/usage/

# A real-work seed's installed gems (seed_prep's bundler `deps:` and CI's
# "Install real-work fixture gems" step), never committed.
evals/real-work/*/seed/**/vendor/bundle/
