{
  "name": "persistent-branches",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["refs/heads/persistent/**"], "exclude": [] } },
  "bypass_actors": [
    { "actor_id": 111111, "actor_type": "Integration", "bypass_mode": "always" },
    { "actor_id": 222222, "actor_type": "Integration", "bypass_mode": "always" }
  ],
  "rules": [{ "type": "deletion" }, { "type": "non_fast_forward" }, { "type": "update" }, { "type": "creation" }]
}
