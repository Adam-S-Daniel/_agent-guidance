# fleet.env: the one file you fill in. Copy it to fleet.env and edit.
# The scripts read it with a strict parser (it is never `source`d), so only
# the keys below are allowed, one KEY=value per line.
#
# NEVER put a secret here: no private key, no client secret, no bearer token,
# no denylist. Those go straight into GitHub environment secrets through
# create-apps.sh and set-secrets.sh, on stdin.

# Your GitHub user or organization: the guide's <you>.
OWNER=acme-example
# user or org. An org uses github.com/organizations/<OWNER>/settings/apps/new.
OWNER_TYPE=user
# free or paid (GitHub Pro for a personal account, Team for an org).
# On free, agent-skills-private and repo-settings are private and unprotected,
# and every other repo is public (guide section 2).
PLAN=free
# Who approves the owner-approval environment (default: OWNER).
REVIEWER=
# Fills the guide's <your name> placeholder in starter files (default: OWNER).
# It lands in PUBLIC repos (agent-skills' marketplace owner and plugin author): use a
# public handle, never your legal name, or the privacy check trips on it.
OWNER_NAME=

# Paid plan only: agent-guidance and skills-evals may be public or private.
# Empty means public. agent-skills is always public; the other two always private.
VISIBILITY_AGENT_GUIDANCE=
VISIBILITY_SKILLS_EVALS=

# Guide 3.3: pin every third-party action to a full SHA. Set false only if you
# pin through .github/workflows/actions.lock and GitHub rejects locked tags.
SHA_PINNING_REQUIRED=true

# Apps are named <prefix>-<app>, e.g. acme-example-guidance-sync. Default:
# OWNER, lowercased. GitHub App names are unique across GitHub, max 34 chars.
APP_NAME_PREFIX=

# Plugins install-machine.sh installs from the <owner>-skills marketplace
# (guide 5.3). Default: <owner>-coding-anywhere.
PLUGINS=

# Numeric App IDs. create-apps.sh fills these in; you can also copy them from
# each App's settings page. apply-rulesets.sh gives skills-evals its full
# persistent-branches ruleset once LOOP_WRITER_APP_ID is set, and
# agent-guidance once GUIDANCE_SYNC_APP_ID is set.
GUIDANCE_SYNC_APP_ID=
SETTINGS_ADMIN_APP_ID=
LOOP_WRITER_APP_ID=
LESSONS_READER_APP_ID=
ROSTER_WRITER_APP_ID=

# Phase 4 required checks (agent-checks, privacy) on every default branch:
# on or off (default off). apply-rulesets.sh --with-required-check writes on,
# --without-required-check writes off; a plain run keeps what is here.
REQUIRED_CHECKS=
