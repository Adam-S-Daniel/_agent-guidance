# fleet.env: the one file you fill in. Copy it to fleet.env and edit.
# The scripts read it with a strict parser (it is never `source`d), so only
# the keys below are allowed, one KEY=value per line.
#
# NEVER put a secret here: no private key, no client secret, no bearer token,
# no denylist. Those go straight into GitHub secrets through create-apps.sh
# and set-secrets.sh, on stdin.

# Your GitHub user or organization: <you> in the docs. copy-starter.sh writes
# it into every starter file, lowercased where the export folded case.
OWNER=acme-example
# The second owner the exported repos name throughout (the owner's fleet
# spans two accounts). Your second account, or, for a one-owner fleet, the
# same login as OWNER: copy-starter.sh refuses a tree that names the second
# owner while this is empty. docs/before-you-start.md, "One owner or two".
OWNER_TWO=
# user or org. An org uses github.com/organizations/<OWNER>/settings/apps/new.
OWNER_TYPE=user
# free or paid (GitHub Pro for a personal account, Team for an org).
# On free, agentskills-private, repo-settings (and waiting-feed) are private
# and unprotected, with no environments, and every other repo is public.
PLAN=free
# Who approves the fleet-apply and plugin-runtime-review environments
# (default: OWNER).
REVIEWER=
# Fills "Example Adopter" and <your name> in starter files (default: OWNER).
# It lands in PUBLIC repos (agentskills' marketplace owner and plugin author):
# use a public handle, never your legal name, or the privacy check trips on it.
OWNER_NAME=

# Paid plan only: these may be public or private. Empty means public.
# agentskills is always public; agentskills-private and repo-settings always private.
VISIBILITY_AGENT_GUIDANCE=
VISIBILITY_SKILLS_EVALS=
VISIBILITY_WSL_AUTOMATION=

# Apps are named <prefix>-<app>, e.g. acme-example-guidance-sync. Default:
# OWNER, lowercased. GitHub App names are unique across GitHub, max 34 chars.
APP_NAME_PREFIX=

# Where install-machine.sh keeps its clones of agentskills and _agent-guidance
# (default ~/repos). The memory-home hook is registered from this path.
REPOS_DIR=

# Numeric App ids. create-apps.sh fills these in; you can also copy them from
# each App's settings page. GUIDANCE_SYNC_APP_ID and ROSTER_WRITER_APP_ID
# become repo-settings variables (fleet.yml's ruleset bypass actors), and
# apply-settings.sh refuses to run while either is empty.
GUIDANCE_SYNC_APP_ID=
SETTINGS_ADMIN_APP_ID=
SETTINGS_READ_APP_ID=
EVAL_IMPROVE_APP_ID=
ROSTER_WRITER_APP_ID=
REGISTRY_READ_APP_ID=

# Optional: eval.yml's Anthropic workload identity federation ids
# (docs/evals-and-loop.md, "Workload identity federation"). Ids, not
# secrets; create-environments.sh makes them skills-evals repository
# variables. Leave them empty if you run evals only through the routine.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
